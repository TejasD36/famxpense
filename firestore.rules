rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isWholeRupee(value) {
      return value is int;
    }

    function isParticipant(data) {
      return data.participantIds != null
        && data.participantIds.hasAny([request.auth.uid]);
    }

    function settlementIdentityUnchanged() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.fromAccountId == resource.data.fromAccountId
        && request.resource.data.toAccountId == resource.data.toAccountId;
    }

    function validSettlementTransition() {
      return resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'rejected', 'cancelled']
        && request.resource.data.resolvedAt is string
        && request.resource.data.resolutionType == request.resource.data.status;
    }

    // Users: any authenticated user can read all users (needed for search),
    // write only own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // Expenses: read if participant (via participantIds array),
    // write only as payer
    match /expenses/{expenseId} {
      allow read: if request.auth != null
        && resource.data.participantIds != null
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.paidByUserId
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.hasAny([request.auth.uid])
        && isWholeRupee(request.resource.data.amount)
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // Accounts: read/write own only
    match /accounts/{accountId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isWholeRupee(request.resource.data.currentBalance)
        && isWholeRupee(request.resource.data.monthlySavingsGoal);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && isWholeRupee(request.resource.data.currentBalance)
        && isWholeRupee(request.resource.data.monthlySavingsGoal);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Immutable idempotency records for account balance changes. These allow
    // clients to retry an offline debit/credit without applying it twice.
    match /account_balance_mutations/{mutationId} {
      // Transactions must be able to confirm that a mutation does not exist
      // before creating it. Keep collection queries owner-scoped so mutation
      // history cannot be enumerated across users.
      allow get: if request.auth != null
        && (!exists(
          /databases/$(database)/documents/account_balance_mutations/$(mutationId)
        ) || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.id == mutationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.accountId is string
        && isWholeRupee(request.resource.data.delta)
        && getAfter(
          /databases/$(database)/documents/accounts/$(request.resource.data.accountId)
        ).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Immutable account history entries. Manual balance edits and deposits are
    // created atomically with their idempotent account balance mutation.
    match /account_entries/{entryId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.id == entryId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.accountId is string
        && isWholeRupee(request.resource.data.amount)
        && isWholeRupee(request.resource.data.previousBalance)
        && isWholeRupee(request.resource.data.newBalance)
        && request.resource.data.newBalance
          == request.resource.data.previousBalance + request.resource.data.amount
        && getAfter(
          /databases/$(database)/documents/accounts/$(request.resource.data.accountId)
        ).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Settlements: read if participant, create/update if participant
    match /settlements/{settlementId} {
      allow read: if request.auth != null
        && isParticipant(resource.data);
      allow create: if request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.hasAll([
          request.resource.data.fromUserId,
          request.resource.data.toUserId
        ])
        && isWholeRupee(request.resource.data.amount)
        && request.resource.data.amount > 0;
      allow update: if request.auth != null
        && isParticipant(resource.data)
        && settlementIdentityUnchanged()
        && validSettlementTransition();
      allow delete: if false;
    }

    // Partnerships: uses senderId/receiverId (not userId/partnerId)
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null
        && resource.data.participantIds != null
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth.uid == resource.data.senderId
        || request.auth.uid == resource.data.receiverId;
      allow delete: if request.auth.uid == resource.data.senderId;
    }

    // Incomes: read/write own only
    match /incomes/{incomeId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isWholeRupee(request.resource.data.amount)
        && request.resource.data.amount > 0;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && isWholeRupee(request.resource.data.amount)
        && request.resource.data.amount > 0;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Notifications: read own only, create allowed for any authed user
    // (notifications are created by the sender on behalf of the recipient)
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if false;
    }

    // Transfers: read/write own only (fromUserId)
    match /transfers/{transferId} {
      allow read: if request.auth != null
        && resource.data.fromUserId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId == request.auth.uid
        && request.resource.data.fromAccountId != request.resource.data.toAccountId
        && isWholeRupee(request.resource.data.amount)
        && request.resource.data.amount > 0;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.fromUserId
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.fromAccountId != request.resource.data.toAccountId
        && isWholeRupee(request.resource.data.amount)
        && request.resource.data.amount > 0;
      allow delete: if false;
    }

    // Monthly savings: read/write own only (userId)
    match /monthly_savings/{snapshotId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.month >= 1
        && request.resource.data.month <= 12
        && isWholeRupee(request.resource.data.goalAmount)
        && isWholeRupee(request.resource.data.savedAmount)
        && isWholeRupee(request.resource.data.openingBalance)
        && isWholeRupee(request.resource.data.closingBalance);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.year == resource.data.year
        && request.resource.data.month == resource.data.month
        && isWholeRupee(request.resource.data.goalAmount)
        && isWholeRupee(request.resource.data.savedAmount)
        && isWholeRupee(request.resource.data.openingBalance)
        && isWholeRupee(request.resource.data.closingBalance);
      allow delete: if false;
    }

    // Debt ledgers: read if participant, write if participant
    match /debt_ledgers/{ledgerId} {
      // The first write uses a transaction that GETs the (not yet existing)
      // ledger doc — permit that read so the document can be created.
      allow read: if request.auth != null
        && (!exists(
          /databases/$(database)/documents/debt_ledgers/$(ledgerId)
        ) || (
          resource.data.participantIds != null
          && resource.data.participantIds.hasAny([request.auth.uid])
        ));
      allow create: if request.auth.uid == request.resource.data.userA
        || request.auth.uid == request.resource.data.userB;

      allow update: if request.auth.uid == resource.data.userA
        || request.auth.uid == resource.data.userB;
      allow delete: if false;
    }

    // Immutable idempotency records for shared-debt adjustments.
    match /debt_ledger_mutations/{mutationId} {
      allow get: if request.auth != null
        && (!exists(
          /databases/$(database)/documents/debt_ledger_mutations/$(mutationId)
        ) || (
          resource.data.participantIds is list
          && resource.data.participantIds.hasAny([request.auth.uid])
        ));
      allow list: if request.auth != null
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.id == mutationId
        && request.resource.data.ledgerId is string
        && isWholeRupee(request.resource.data.delta)
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.hasAny([request.auth.uid])
        && getAfter(
          /databases/$(database)/documents/debt_ledgers/$(request.resource.data.ledgerId)
        ).data.participantIds.hasAny([request.auth.uid]);
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
